APP_NAME="Dashboard Bidtech"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta
FRONTEND_URL=http://localhost:3000

APP_LOCALE=id
