# ── Build (lokal & GitHub Actions) ────────────────────────────────────────────
# URL produksi tanpa "/" akhir → canonical, hreflang, sitemap, robots, llms.txt, JSON-LD.
# TODO(OQ-02): ganti setelah domain klien dipastikan (di GitHub: Variables → SITE_URL).
NUXT_PUBLIC_SITE_URL=https://funtravel.example

# Opsional — Google Analytics 4 (hanya bila klien setuju). Kosongkan untuk menonaktifkan.
NUXT_PUBLIC_GA_ID=

# ── VPS (/opt/funtravel/.env — jangan di-commit) ──────────────────────────────
# IMAGE & IMAGE_TAG ditimpa otomatis oleh workflow deploy setiap rilis.
IMAGE=ghcr.io/<owner-github>/funtravel
IMAGE_TAG=latest
# Port localhost untuk Nginx host. Pastikan bebas: ss -tulpn | grep 3050
HOST_PORT=3050
