  "destinations": [
    {
      "id": "barelang-bridge",
      "island": "batam",
      "name": {
        "en": "Barelang Bridge (Jembatan 1–6)",
        "ms": "Jambatan Barelang (Jambatan 1–6)",
        "zh": "巴里朗大桥 (1–6桥)",
        "id": "Jembatan Barelang (Jembatan 1–6)"
      },
      "summary": {
        "en": "Batam's most iconic landmark connecting six scenic islands with coastal photo spots and fresh kelong seafood.",
        "ms": "Mercu tanda ikonik Batam yang menghubungkan 6 pulau dengan lokasi bergambar laut dan restoran kelong seafood segar.",
        "zh": "连接六座岛屿的巴淡标志性壮丽大桥，拥有无敌海景打卡点与水上奎笼海鲜美食。",
        "id": "Ikon legendaris Batam yang menghubungkan 6 pulau eksotis dengan spot foto laut dan restoran kelong seafood segar."
      },
      "image": "/images/destinations/barelang-bridge.webp"
    },
    {
      "id": "welcome-to-batam",
      "island": "batam",
      "name": {
        "en": "Welcome to Batam Landmark",
        "ms": "Mercu Tanda Welcome to Batam",
        "zh": "Welcome to Batam 巨型地标",
        "id": "Welcome to Batam"
      },
      "summary": {
        "en": "Iconic hilltop landmark near the ferry terminal, grand mosque, and authentic Indonesian street food stalls.",
        "ms": "Papan tanda gergasi di atas bukit berhampiran terminal feri, masjid agung, dan medan selera makanan tempatan.",
        "zh": "坐落在山坡上的巨型城市地标，邻近渡轮码头、大清真寺与本地特色风味小吃街。",
        "id": "Tulisan raksasa di atas bukit hijau dekat pelabuhan ferry, masjid agung, dan pusat jajanan kuliner lokal."
      },
      "image": "/images/destinations/welcome-to-batam.webp"
    },
    {
      "id": "pink-beach",
      "island": "bintan",
      "name": {
        "en": "Sand Dunes & Blue Lake Bintan",
        "ms": "Gurun Pasir Busung & Telaga Biru",
        "zh": "民丹岛黄金沙丘与蓝湖",
        "id": "Gurun Pasir & Telaga Biru Bintan"
      },
      "summary": {
        "en": "Surreal turquoise crater lake surrounded by golden sand dunes in Busung, Bintan.",
        "ms": "Tasik kawah membiru kristal yang dikelilingi bukit pasir keemasan di Busung, Bintan.",
        "zh": "民丹岛布松超现实绿松石色蓝湖与金色沙丘，犹如置身热带沙漠绿洲的拍照圣地。",
        "id": "Danau kawah toska jernih yang dikelilingi perbukitan pasir keemasan ala gurun di Busung, Bintan."
      },
      "image": "/images/destinations/telaga-biru-bintan.webp"
    },
    {
      "id": "grand-batam",
      "island": "batam",
      "name": {
        "en": "Grand Batam & Nagoya Hill Malls",
        "ms": "Pusat Beli-Belah Grand Batam & Nagoya Hill",
        "zh": "Grand Batam 与 Nagoya Hill 购物中心",
        "id": "Grand Batam & Nagoya Hill Mall"
      },
      "summary": {
        "en": "Top shopping malls, traditional reflexology spa parlors, authentic Kue Lapis bakeries, and culinary hotspots.",
        "ms": "Pusat beli-belah moden terulung, pusat refleksologi urut, kedai kek lapis harum, dan destinasi makan lazat.",
        "zh": "顶级现代购物中心、正宗印尼千层糕手信店、传统泰式/印尼足疗按摩与美食云集。",
        "id": "Mall perbelanjaan favorit terlengkap, panti pijat refleksi keluarga, toko kue lapis legit, dan aneka kuliner lezat."
      },
      "image": "/images/destinations/grand-batam.webp"
    },
    {
      "id": "nongsa-beach",
      "island": "batam",
      "name": {
        "en": "Nongsa Coast & Beach Resorts",
        "ms": "Persisiran Nongsa & Resort Pantai",
        "zh": "农沙海滨与沙滩度假村",
        "id": "Kawasan Pantai & Resort Nongsa"
      },
      "summary": {
        "en": "A relaxed beach area in northeast Batam with luxury beach clubs, golf courses, and stunning sunset views.",
        "ms": "Kawasan pantai santai di timur laut Batam dengan kelab pantai mewah, padang golf, dan matahari terbenam indah.",
        "zh": "巴淡岛东北部的静谧高端度假胜地，拥有高品质沙滩俱乐部、高尔夫球场与壮美日落。",
        "id": "Kawasan resor pantai tenang di timur laut Batam dengan beach club eksklusif, padang golf, dan panorama sunset memukau."
      },
      "image": "/images/destinations/nongsa-beach.webp"
    }
