APP_NAME="Semesta Pro"
# local | staging | production
APP_ENV=local
# ./artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:3000
APP_HOST=127.0.0.1
APP_PORT=3000

LOG_CHANNEL=stack
LOG_LEVEL=debug

HTTP_REQUEST_TIMEOUT=30

DB_CONNECTION=sqlite
DB_DATABASE=storage/database/semestapro.db

# Sesi: di production set SESSION_SECURE=true (butuh HTTPS)
SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Foto properti (RustFS, S3-compatible; bucket publik-baca, lihat docs/SCHEMA.md §10). Isi walau di lokal: driver S3 menolak
# konfigurasi kosong saat disk "media" dipakai.
FILESYSTEM_DISK=local
MEDIA_KEY=
MEDIA_SECRET=
MEDIA_REGION=us-east-1
MEDIA_BUCKET=semestapro-media
MEDIA_ENDPOINT=http://127.0.0.1:9000
# Dev: URL path-style langsung ke RustFS. Produksi: MEDIA_ENDPOINT=https://cdn.semestapro.co.id dan
# MEDIA_URL=https://cdn.semestapro.co.id/semestapro-media (Nginx, deploy/nginx/cdn.semestapro.co.id.conf)
MEDIA_URL=http://127.0.0.1:9000/semestapro-media
MEDIA_USE_PATH_STYLE=true

# Situs & kontak (nilai bawaan ada di config/site.go)
SITE_WHATSAPP=6281285552016
SITE_PHONE_DISPLAY=0812-8555-2016
SITE_EMAIL=darsonhutagalung20@gmail.com
SECURITY_CONTACT=security@semestapro.co.id
AI_CRAWLERS_ALLOWED=true

KPR_DEFAULT_RATE=7.5
KPR_DEFAULT_DP=20
KPR_DEFAULT_TENOR_MONTHS=180

IMAGE_MAX_CONCURRENCY=2
